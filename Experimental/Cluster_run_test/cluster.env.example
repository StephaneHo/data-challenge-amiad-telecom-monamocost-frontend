# Copier vers cluster.env et adapter (cluster.env n'est pas versionné).
#
#   cp cluster.env.example cluster.env
#
# Connexion SSH / rsync
# Utiliser l'alias défini dans ~/.ssh/config (recommandé) :
#   Host gpu
#       Hostname gpu-gw.enst.fr
#       User <username>
#       IdentityFile ~/.ssh/id_rsa
CLUSTER_SSH_TARGET=gpu
CLUSTER_USER=l<username>
# Chemin distant : quotes simples → pas d'expansion locale du ~
CLUSTER_REMOTE_DIR='~/AMIAD/Cluster_run_test'

# Alternative sans alias SSH :
# CLUSTER_USER=<username>
# CLUSTER_HOST=gpu-gw.enst.fr

# SLURM (valeurs par défaut — surchargeables à la soumission)
SLURM_PARTITION=3090
SLURM_GPUS=1
SLURM_MEM=48G
SLURM_TIME=24:00:00
SLURM_CPUS=8
SLURM_JOB_NAME=e5-finetune

# Répertoire de données parent optionnel (--with-data)
CLUSTER_EXTRA_DATA_DIR=../../Experimental/DATA

# Arguments passés à run_finetune.py sur le cluster
FINETUNE_ARGS="--epochs 3 --batch_size 32 --max_paragraphs_per_doc 15 --k_neg 4 --log_every 10"

# Secrets / tokens (optionnel — aussi supporté via backend/.env)
# HF_TOKEN=hf_...
